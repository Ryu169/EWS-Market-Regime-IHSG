{
  "data_dir": "../Future-Enginering/output/targets",
  "feature_set": "core",
  "seed": 2026,
  "trees": 300,
  "jobs": 2,
  "models": ["xgboost", "lightgbm"],
  "refit_development": true,
  "selection": {
    "macro_f1_tolerance": 0.001,
    "tie_break_order": ["lower_sample_std_macro_f1", "higher_mean_accuracy", "algorithm_name"]
  },
  "xgboost": {
    "objective": "multi:softprob",
    "num_class": 3,
    "tree_method": "hist",
    "device": "cpu",
    "max_depth": 4,
    "learning_rate": 0.05,
    "subsample": 1.0,
    "colsample_bytree": 1.0,
    "reg_lambda": 1.0,
    "eval_metric": "mlogloss",
    "verbosity": 0
  },
  "lightgbm": {
    "objective": "multiclass",
    "num_class": 3,
    "device_type": "cpu",
    "max_depth": 4,
    "num_leaves": 15,
    "learning_rate": 0.05,
    "min_child_samples": 20,
    "reg_lambda": 1.0,
    "deterministic": true,
    "force_col_wise": true,
    "verbosity": -1
  }
}
